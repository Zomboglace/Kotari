{
  "name": "kotari",
  "productName": "Kotari",
  "version": "0.3.3",
  "description": "Fiches imbriquées en local et édition à plusieurs en temps réel",
  "author": "Nicolas",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server": "node scripts/build-server.mjs && node dist-server/kotari-server/kotari-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-collaboration": "^3.33.1",
    "@tiptap/extension-collaboration-caret": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zomboglace/Kotari.git"
  },
  "homepage": "https://github.com/Zomboglace/Kotari"
}
